{
  "name": "@conao3/bunsai",
  "version": "1.1.1",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun",
    "prepack": "bun run scripts/prepack-dashboard.ts",
    "postpack": "bun run scripts/postpack-dashboard.ts"
  },
  "description": "Local AWS emulator - a LocalStack alternative on Bun",
  "bin": {
    "bunsai": "src/cli.ts"
  },
  "files": [
    "src",
    "models",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conao3/bun-bunsai.git"
  }
}
