        "ExpressionAttributeValues": { ":pk": { "S": "user" } }
      },
      "expected": { "Count": 2 },
      "ignorePaths": ["$metadata"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "DeleteTableCommand",
