      "command": "GetResourcePolicyCommand",
      "input": {
        "ResourceArn": "${tbl.TableDescription.TableArn}"
      },
      "expectedError": {
        "name": "PolicyNotFoundException",
        "statusCode": 400
      },
      "ignorePaths": ["$metadata"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "DeleteTableCommand",
      "input": { "TableName": "parity-ddb-respolicy" },
