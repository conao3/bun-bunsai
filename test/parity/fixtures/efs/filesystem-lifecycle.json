            "Encrypted": false,
            "NumberOfMountTargets": 0
          }
        ]
      },
      "ignorePaths": [
        "$metadata",
        "Marker",
        "NextMarker",
        "FileSystems[0].OwnerId",
        "FileSystems[0].FileSystemArn",
        "FileSystems[0].CreationTime",
        "FileSystems[0].SizeInBytes",
        "FileSystems[0].Tags",
        "FileSystems[0].Name",
        "FileSystems[0].KmsKeyId",
        "FileSystems[0].ProvisionedThroughputInMibps",
        "FileSystems[0].AvailabilityZoneName",
        "FileSystems[0].AvailabilityZoneId",
        "FileSystems[0].FileSystemProtection"
      ],
      "saveAs": null,
      "refs": { "fs.FileSystemId": "fs" }
    },
    {
      "command": "DeleteFileSystemCommand",
      "input": {
        "FileSystemId": "${fs.FileSystemId}"
      },
      "expected": {},
      "ignorePaths": ["$metadata"],
      "saveAs": null,
      "refs": { "fs.FileSystemId": "fs" }
