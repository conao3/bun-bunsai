      "expected": { "RuleArn": "<ANY>" },
      "ignorePaths": ["$metadata"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "DescribeRuleCommand",
      "input": { "Name": "parity-rule" },
      "expected": {
