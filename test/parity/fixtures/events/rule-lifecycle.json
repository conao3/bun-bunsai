            "State": "ENABLED"
          }
        ]
      },
      "ignorePaths": ["$metadata"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "DisableRuleCommand",
      "input": { "Name": "parity-rule" },
      "expected": {},
