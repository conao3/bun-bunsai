      "saveAs": null,
      "refs": {}
    },
    {
      "command": "DescribeRuleCommand",
      "input": { "Name": "parity-rule" },
      "expected": {
        "Name": "parity-rule",
        "State": "DISABLED"
      },
      "ignorePaths": ["$metadata"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "DeleteRuleCommand",
      "input": { "Name": "parity-rule" },
