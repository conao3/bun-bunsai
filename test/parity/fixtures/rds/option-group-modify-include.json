                { "Name": "SERVER_AUDIT_FILE_ROTATE_SIZE", "Value": "1000" }
              ]
            }
          ]
        }
      },
      "ignorePaths": [
        "$metadata",
        "OptionGroup.Options.0.Permanent",
        "OptionGroup.Options.0.Persistent"
      ],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "ModifyOptionGroupCommand",
      "input": {
        "OptionGroupName": "parity-og-inc",
        "OptionsToRemove": ["MARIADB_AUDIT_PLUGIN"],
        "ApplyImmediately": true
