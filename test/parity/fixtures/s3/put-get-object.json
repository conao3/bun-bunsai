{
  "clientPackage": "@aws-sdk/client-s3",
  "clientName": "S3Client",
  "clientConfig": { "forcePathStyle": true },
  "steps": [
    {
      "command": "CreateBucketCommand",
      "input": { "Bucket": "parity-s3-obj" },
      "expected": { "Location": "/parity-s3-obj" },
      "ignorePaths": ["$metadata"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "PutObjectCommand",
      "input": {
        "Bucket": "parity-s3-obj",
        "Key": "hello-key",
        "Body": { "$base64": "aGVsbG8gcGFyaXR5" },
        "ContentType": "text/plain"
      },
      "expected": { "ETag": "\"ef2a02275b08a52915d74cba1e1f4e3e\"" },
      "ignorePaths": ["$metadata"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "GetObjectCommand",
      "input": { "Bucket": "parity-s3-obj", "Key": "hello-key" },
      "expected": {
        "ETag": "\"ef2a02275b08a52915d74cba1e1f4e3e\"",
        "ContentType": "text/plain",
        "ContentLength": 12,
        "Body": "<ANY>",
        "ServerSideEncryption": "AES256"
      },
      "ignorePaths": ["$metadata", "LastModified", "Metadata", "AcceptRanges"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "HeadObjectCommand",
      "input": { "Bucket": "parity-s3-obj", "Key": "hello-key" },
      "expected": {
        "ETag": "\"ef2a02275b08a52915d74cba1e1f4e3e\"",
        "ContentType": "text/plain",
        "ContentLength": 12,
        "ServerSideEncryption": "AES256"
      },
      "ignorePaths": ["$metadata", "LastModified", "Metadata", "AcceptRanges"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "DeleteObjectCommand",
      "input": { "Bucket": "parity-s3-obj", "Key": "hello-key" },
      "expected": {},
      "ignorePaths": ["$metadata"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "DeleteBucketCommand",
      "input": { "Bucket": "parity-s3-obj" },
      "expected": {},
      "ignorePaths": ["$metadata"],
      "saveAs": null,
      "refs": {}
    }
  ]
}
