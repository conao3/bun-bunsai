{
  "clientPackage": "@aws-sdk/client-s3",
  "clientName": "S3Client",
  "clientConfig": { "forcePathStyle": true },
  "steps": [
    {
      "command": "CreateBucketCommand",
      "input": { "Bucket": "pm-put-if-none-match" },
      "expected": {},
      "ignorePaths": ["$metadata", "Location"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "PutObjectCommand",
      "input": {
        "Bucket": "pm-put-if-none-match",
        "Key": "test_object",
        "Body": "test",
        "IfNoneMatch": "*"
      },
      "expected": {},
      "ignorePaths": ["$metadata", "ETag", "ServerSideEncryption"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "PutObjectCommand",
      "input": {
        "Bucket": "pm-put-if-none-match",
        "Key": "test_object",
        "Body": "another_test",
        "IfNoneMatch": "*"
      },
      "expectedError": { "name": "PreconditionFailed", "statusCode": 412 },
      "ignorePaths": ["$metadata"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "DeleteObjectCommand",
      "input": { "Bucket": "pm-put-if-none-match", "Key": "test_object" },
      "expected": {},
      "ignorePaths": ["$metadata"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "DeleteBucketCommand",
      "input": { "Bucket": "pm-put-if-none-match" },
      "expected": {},
      "ignorePaths": ["$metadata"],
      "saveAs": null,
      "refs": {}
    }
  ]
}
