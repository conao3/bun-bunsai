{
  "clientPackage": "@aws-sdk/client-secrets-manager",
  "clientName": "SecretsManagerClient",
  "steps": [
    {
      "command": "CreateSecretCommand",
      "input": {
        "Name": "parity-sm-create-get",
        "SecretString": "hello-secret"
      },
      "expected": {
        "ARN": "<ANY>",
        "Name": "parity-sm-create-get",
        "VersionId": "<ANY>"
      },
      "ignorePaths": ["$metadata"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "GetSecretValueCommand",
      "input": { "SecretId": "parity-sm-create-get" },
      "expected": {
        "ARN": "<ANY>",
        "Name": "parity-sm-create-get",
        "SecretString": "hello-secret",
        "VersionStages": ["AWSCURRENT"]
      },
      "ignorePaths": ["$metadata", "VersionId", "CreatedDate"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "DeleteSecretCommand",
      "input": {
        "SecretId": "parity-sm-create-get",
        "ForceDeleteWithoutRecovery": true
      },
      "expected": {
        "ARN": "<ANY>",
        "Name": "parity-sm-create-get"
      },
      "ignorePaths": ["$metadata", "DeletionDate"],
      "saveAs": null,
      "refs": {}
    }
  ]
}
