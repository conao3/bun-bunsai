{
  "clientPackage": "@aws-sdk/client-secrets-manager",
  "clientName": "SecretsManagerClient",
  "steps": [
    {
      "command": "CreateSecretCommand",
      "input": {
        "Name": "parity-sm-describe",
        "SecretString": "some-value",
        "Description": "parity test description"
      },
      "expected": {
        "ARN": "<ANY>",
        "Name": "parity-sm-describe",
        "VersionId": "<ANY>"
      },
      "ignorePaths": ["$metadata"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "DescribeSecretCommand",
      "input": { "SecretId": "parity-sm-describe" },
      "expected": {
        "ARN": "<ANY>",
        "Name": "parity-sm-describe",
        "Description": "parity test description",
        "RotationEnabled": false
      },
      "ignorePaths": [
        "$metadata",
        "CreatedDate",
        "LastChangedDate",
        "LastAccessedDate",
        "VersionIdsToStages",
        "Tags"
      ],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "DeleteSecretCommand",
      "input": {
        "SecretId": "parity-sm-describe",
        "ForceDeleteWithoutRecovery": true
      },
      "expected": {
        "ARN": "<ANY>",
        "Name": "parity-sm-describe"
      },
      "ignorePaths": ["$metadata", "DeletionDate"],
      "saveAs": null,
      "refs": {}
    }
  ]
}
