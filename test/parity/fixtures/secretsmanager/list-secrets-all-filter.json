{
  "clientPackage": "@aws-sdk/client-secrets-manager",
  "clientName": "SecretsManagerClient",
  "steps": [
    {
      "command": "CreateSecretCommand",
      "input": { "Name": "pm-filter-one", "SecretString": "s" },
      "expected": { "Name": "pm-filter-one", "ARN": "<ANY>" },
      "ignorePaths": ["$metadata", "VersionId"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "CreateSecretCommand",
      "input": {
        "Name": "pm-filter-two",
        "SecretString": "s",
        "Description": "DescTwo"
      },
      "expected": { "Name": "pm-filter-two", "ARN": "<ANY>" },
      "ignorePaths": ["$metadata", "VersionId"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "ListSecretsCommand",
      "input": { "Filters": [{ "Key": "all", "Values": ["DescTwo"] }] },
      "expected": {
        "SecretList": [{ "Name": "pm-filter-two", "Description": "DescTwo" }]
      },
      "ignorePaths": [
        "$metadata",
        "SecretList.0.ARN",
        "SecretList.0.LastChangedDate",
        "SecretList.0.CreatedDate",
        "SecretList.0.SecretVersionsToStages",
        "SecretList.0.Tags"
      ],
      "saveAs": null,
      "refs": {}
    }
  ]
}
