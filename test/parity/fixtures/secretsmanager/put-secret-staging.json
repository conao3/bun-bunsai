{
  "clientPackage": "@aws-sdk/client-secrets-manager",
  "clientName": "SecretsManagerClient",
  "steps": [
    {
      "command": "CreateSecretCommand",
      "input": {
        "Name": "parity-sm-staging",
        "SecretString": "initial-value"
      },
      "expected": {
        "ARN": "<ANY>",
        "Name": "parity-sm-staging",
        "VersionId": "<ANY>"
      },
      "ignorePaths": ["$metadata"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "PutSecretValueCommand",
      "input": {
        "SecretId": "parity-sm-staging",
        "SecretString": "updated-value",
        "VersionStages": ["AWSPENDING"]
      },
      "expected": {
        "ARN": "<ANY>",
        "Name": "parity-sm-staging",
        "VersionId": "<ANY>",
        "VersionStages": ["AWSPENDING"]
      },
      "ignorePaths": ["$metadata"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "GetSecretValueCommand",
      "input": { "SecretId": "parity-sm-staging" },
      "expected": {
        "Name": "parity-sm-staging",
        "SecretString": "initial-value",
        "VersionStages": ["AWSCURRENT"]
      },
      "ignorePaths": ["$metadata", "ARN", "VersionId", "CreatedDate"],
      "saveAs": null,
      "refs": {}
    },
    {
      "command": "DeleteSecretCommand",
      "input": {
        "SecretId": "parity-sm-staging",
        "ForceDeleteWithoutRecovery": true
      },
      "expected": {
        "ARN": "<ANY>",
        "Name": "parity-sm-staging"
      },
      "ignorePaths": ["$metadata", "DeletionDate"],
      "saveAs": null,
      "refs": {}
    }
  ]
}
