      "expected": {
        "Messages": [
          {
            "Body": "hello parity",
            "MD5OfBody": "<ANY>",
            "MessageId": "<ANY>",
            "ReceiptHandle": "<ANY>"
          }
        ]
      },
      "ignorePaths": ["$metadata"],
      "saveAs": "recv",
