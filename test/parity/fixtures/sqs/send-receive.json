      "expected": { "QueueUrl": "<ANY>" },
      "ignorePaths": ["$metadata"],
      "saveAs": "q",
      "refs": {}
    },
    {
      "command": "SendMessageCommand",
      "input": {
        "QueueUrl": "${q.QueueUrl}",
